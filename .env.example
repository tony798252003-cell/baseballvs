# Frontend (Vite) — publishable key only
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Scripts (scripts/*.mjs, run from repo root) — secret key, never expose to the frontend
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dropbox OAuth (scripts/add-player-song.mjs, scripts/migrate-legacy-songs.mjs, chant studio)
# Fill APP_KEY/APP_SECRET, then run `node scripts/dropbox-auth.mjs` to write DROPBOX_REFRESH_TOKEN
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Legacy fallback: short-lived static access token (used only if no refresh token is set)
DROPBOX_TOKEN=
