# Frontend (Vite) — publishable key only
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Scripts (scripts/*.mjs, run from repo root) — secret key, never expose to the frontend
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dropbox access token used by scripts/add-player-song.mjs and scripts/migrate-legacy-songs.mjs
DROPBOX_TOKEN=
